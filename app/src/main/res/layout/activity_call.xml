<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- ── Tuile distante 1 ───────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/containerRemote1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tile">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/remoteRenderer1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Halo "qui parle" (animé depuis le code) -->
            <View
                android:id="@+id/ringSpeaking1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ring_idle"/>

            <!-- État "En attente" -->
            <LinearLayout
                android:id="@+id/waitingGroup1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ProgressBar
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="@color/accent_green"/>

                <TextView
                    android:id="@+id/tvWaiting1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="En attente…"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLeft1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A quitté"
                android:textColor="@color/red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <!-- Pastille nom -->
            <TextView
                android:id="@+id/tvRemoteName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_name_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </FrameLayout>

        <!-- ── Tuile distante 2 ───────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/containerRemote2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tile">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/remoteRenderer2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <View
                android:id="@+id/ringSpeaking2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ring_idle"/>

            <LinearLayout
                android:id="@+id/waitingGroup2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ProgressBar
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="@color/accent_green"/>

                <TextView
                    android:id="@+id/tvWaiting2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="En attente…"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLeft2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A quitté"
                android:textColor="@color/red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvRemoteName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_name_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </FrameLayout>

        <!-- ── Barre de contrôles ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/controlsBar"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/btnFlipCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_normal"
                android:src="@drawable/ic_flip_camera"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Retourner caméra"/>

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_normal"
                android:src="@drawable/ic_mic"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Micro"/>

            <ImageButton
                android:id="@+id/btnHangup"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_danger"
                android:src="@drawable/ic_call_end"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:contentDescription="Raccrocher"/>

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_normal"
                android:src="@drawable/ic_videocam"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Caméra"/>

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_normal"
                android:src="@drawable/ic_volume_up"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="Haut-parleur"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Chrono d'appel (haut, centré) ──────────────────────────────── -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_duration_chip"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:elevation="6dp"
        android:visibility="gone"/>

    <!-- ── Aperçu local (déplaçable depuis le code) ───────────────────── -->
    <FrameLayout
        android:id="@+id/localPreviewContainer"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:padding="3dp"
        android:background="@drawable/bg_local_preview"
        android:elevation="8dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/ivLocalMute"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/bg_name_pill"
            android:padding="3dp"
            android:src="@drawable/ic_mic_off"
            android:visibility="gone"
            android:contentDescription="Micro coupé"/>

    </FrameLayout>

</FrameLayout>
